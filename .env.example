# Copy to .env and adjust. Every value has a working default for local runs.

# Where all data lives (landing CSVs, Parquet lake, DuckDB warehouse)
OLIST_DATA_DIR=data
# DuckDB file used by the pipeline and by dbt
DUCKDB_PATH=data/warehouse/olist.duckdb

# Serving database (docker compose up postgres)
POSTGRES_DSN=postgresql://olist:olist@localhost:5432/olist

# Kafka (docker compose up kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDERS=olist.orders.v1

# LLM enrichment: keyword | ollama | anthropic
LLM_PROVIDER=keyword
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# MLflow: empty = local mlflow.db (SQLite); or http://localhost:5000 for a tracking server
MLFLOW_TRACKING_URI=
